# ============================================================
# ⚽ Football Stats Analyzer — Configuração
# ============================================================

# 🔑 Chave da API Anthropic (Claude)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# 🔑 Chave da API-Football
# Obtenha em: https://www.api-football.com/
# Plano gratuito: 100 req/dia
FOOTBALL_API_KEY=sua-chave-api-football-aqui

# ⚙️ Modo de acesso à API-Football
# false = API direta (v3.football.api-sports.io) — RECOMENDADO
# true  = via RapidAPI (api-football-v1.p.rapidapi.com)
USE_RAPIDAPI=false
